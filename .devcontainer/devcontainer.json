{
  "name": "Python App (Existing Dockerfile)",
  "build": {
    // Path to your existing Dockerfile relative to this file
    "dockerfile": "../docker/dev/Dockerfile",
    // Context path where the docker build command should execute
    "context": ".."
  },

  // Expecting there to be Dashbeard in the parent folder
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "runArgs": [
    "--cap-add",
    "SYS_NICE",
    "--ulimit",
    "rtprio=99",
    "--privileged",
    "--group-add audio",
    "--group-add video",
    "-v",
    "/run/user/${localEnv:USERID}:/run/user/${localEnv:USERID}",
    "-v",
    "/etc/passwd:/etc/passwd:ro",
    "-v",
    "/etc/group:/etc/group:ro",
    "-v","/dev/shm:/dev/shm"
  ],
  "containerEnv": {
    "XDG_RUNTIME_DIR": "/run/user/${localEnv:USERID}",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/${localEnv:USERID}/bus"
  },
  // Automatically installs vital Python tooling inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", // Core Python language support
        "charliermarsh.ruff",
        "meta.pyrefly",
        "ms-vscode.vscode-typescript-next",
        "rust-lang.rust-analyzer",
        "coolbear.systemd-unit-file",
        "samuelcolvin.jinjahtml",
        "ExodiusStudios.comment-anchors",
        "tamasfe.even-better-toml",
        "ecmel.vscode-html-css"
      ]
    }
  },
  "features": {
    "ghcr.io/helpers4/devcontainer/playwright-dev:1": {}
  },

   "remoteUser": "${localEnv:USERNAME}"
}
