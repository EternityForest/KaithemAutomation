{
  "name": "Python App (Existing Dockerfile)",
  "build": {
    // Path to your existing Dockerfile relative to this file
    "dockerfile": "../docker/dev/Dockerfile",
    // Context path where the docker build command should execute
    "context": ".."
  },

  "runArgs": [
    "--cap-add",
    "SYS_NICE",
    "--ulimit",
    "rtprio=99",
    "--privileged",
    "--group-add audio",
    "--group-add video",
    "-v",
    "/run/user/${localEnv:USERID}:/run/user/1000",
    "-v",
    "/etc/passwd:/etc/passwd:ro",
    "-v",
    "/etc/group:/etc/group:ro"
  ],
  "containerEnv": {
    "XDG_RUNTIME_DIR": "/run/user/1000",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus"
  },
  // Automatically installs vital Python tooling inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", // Core Python language support
        "charliermarsh.ruff",
        "meta.pyrefly",
        "ms-vscode.vscode-typescript-next",
        "rust-lang.rust-analyzer",
        "coolbear.systemd-unit-file",
        "samuelcolvin.jinjahtml",
        "ExodiusStudios.comment-anchors",
        "tamasfe.even-better-toml",
        "ecmel.vscode-html-css"
      ]
    }
  },

  "mounts": [
    {
      "source": "${localWorkspaceFolder}/../Dashbeard",
      "target": "/workspaces/Dashbeard",
      "type": "bind"
    }
  ]

  // Connects as a non-root user if your Dockerfile creates one (optional)
  // "remoteUser": "vscode"
}
