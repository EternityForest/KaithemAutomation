{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to kaithem-dev docker process",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5178 },
      "subProcess": true,
      "justMyCode": false,
      "pathMappings": [
        // WARNING: This is a hack, the paths have to be updated for python
        // version changes, and the python version in the docker image has to match the local python version for this to work.
        {
          "localRoot": "${workspaceFolder:KaithemAutomation}/.venv/lib/python3.12/site-packages",
          "remoteRoot": "/workspace/KaithemAutomation/.venv/lib/python3.13/site-packages"
        },
        {
          "localRoot": "${workspaceFolder:KaithemAutomation}",
          "remoteRoot": "/workspace/KaithemAutomation"
        },
      ]
    },

    {
      "name": "Python: Attach using Process Id",
      "type": "python",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false,
      "subProcess": true
    },
    {
      "name": "Python3",
      "type": "debugpy",
      "python": "${workspaceFolder}/.venv/bin/python3",
      "request": "launch",
      "stopOnEntry": true,
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": {
        "GST_DEBUG": "*:3",
        "WASMTIME_BACKTRACE_DETAILS": "1"
      },
      "envFile": "${workspaceFolder}/.env",
      "debugOptions": ["RedirectOutput"],
      "justMyCode": false,
      "subProcess": true
    }
  ]
}
